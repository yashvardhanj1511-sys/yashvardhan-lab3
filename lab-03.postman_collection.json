    {
      "name": "4. GET Sort by Price DESC",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            }
          ]
        },
        "description": "Sort books by price from highest to lowest."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Books are ordered by price descending\", function () {",
              "    var jsonData = pm.response.json();",
              "    for (var i = 1; i < jsonData.length; i++) {",
              "        pm.expect(jsonData[i-1].price).to.be.at.least(jsonData[i].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
